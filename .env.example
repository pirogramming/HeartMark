# 로컬 개발용 예시. 이 파일을 .env로 복사해서 값을 채운다.
# 아래 DJANGO_* 값들은 로컬에서는 비워둬도 된다(기본값이 개발용으로 잡혀 있음).
# EC2의 ~/heartmark/.env 에는 반드시 채워야 한다.

# --- 배포 환경에서만 필요한 값 ---
# 서버용 시크릿 키. 아래 명령으로 새로 만들어 쓸 것:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Django의 get_random_secret_key()를 써도 되지만 #, $, ' 같은 문자가 섞일 수 있다.
# 이 .env는 docker compose가 변수 치환에도 사용하므로 그런 문자는 값이 깨질 수 있어
# 영숫자와 -_ 만 나오는 token_urlsafe를 권장한다.
DJANGO_SECRET_KEY=
# EC2 퍼블릭 IP나 도메인. 콤마로 여러 개 지정 가능.
DJANGO_ALLOWED_HOSTS=
# 스킴을 포함해야 한다. 예: http://12.34.56.78
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- 사이트/소셜 로그인 ---
# 배포 시에는 EC2 주소로 바꿔야 소셜 로그인 redirect가 맞는다.
SITE_DOMAIN=127.0.0.1:8000
SITE_NAME=HeartMark Local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 카카오맵 ---
KAKAO_REST_KEY=
KAKAO_JS_KEY=
